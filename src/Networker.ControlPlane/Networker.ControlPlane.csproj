<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reaper's scope-resolution/argv helpers are internal (implementation
         detail, not API) but unit-tested — expose internals to the test project. -->
    <InternalsVisibleTo Include="Networker.ControlPlane.Tests" />
    <InternalsVisibleTo Include="Networker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static curated cloud price table for the perf-per-cost report
         (Reports/CloudCostTable.cs). Embedded so deploys can't lose it;
         the repo-root shared/ copy stays the editable source of truth. -->
    <EmbeddedResource Include="..\..\shared\cloud-costs.json"
                      Link="shared\cloud-costs.json"
                      LogicalName="Networker.ControlPlane.shared.cloud-costs.json" />

    <!-- Canonical HTTP-stack layout + capabilities (Endpoints/HttpStackCatalog.cs):
         which proxy stacks the installers configure with HTTP/3, and which
         probe modes need it. Served by GET /api/http-stacks (+ /api/modes
         `stacks`) and drives the mode⇄target h3 gate. Same JSON the Rust
         tester embeds and lab/validate.sh reads. -->
    <EmbeddedResource Include="..\..\shared\http-stacks.json"
                      Link="shared\http-stacks.json"
                      LogicalName="Networker.ControlPlane.shared.http-stacks.json" />

    <!-- Canonical SDK sample catalog (Endpoints/SdkSampleCatalog.cs): the
         reference apps under sdk/<lang>/example, the port LagHound deploys
         each on, and the SDK version each reports on /laghound/health — the
         "current" half of the outdated comparison. Served by
         GET /api/projects/{id}/sdk-endpoints/samples; the same ids ride the
         deploy config's endpoints[].sdk_samples into install.sh. -->
    <EmbeddedResource Include="..\..\shared\sdk-samples.json"
                      Link="shared\sdk-samples.json"
                      LogicalName="Networker.ControlPlane.shared.sdk-samples.json" />

    <!-- The networker-tester probe-result schema (V001–V005, PostgreSQL),
         mirrored from crates/networker-tester/src/output/db/postgres.rs (a Rust
         unit test guards the copy). AttemptPersister applies it lazily on the
         first streamed attempt so a FRESH control-plane database gets the
         RequestAttempt/… tables — the C# agent path never runs a DB-backed
         tester, and without this a new install persisted 0 attempts forever
         (caught by lab/validate.sh). -->
    <EmbeddedResource Include="..\..\shared\tester-schema.postgres.sql"
                      Link="shared\tester-schema.postgres.sql"
                      LogicalName="Networker.ControlPlane.shared.tester-schema.postgres.sql" />

    <!-- LagHound brand SVGs for the report exporters (Reports/Documents/).
         Embedded so a deploy can't lose them; the assets/brand/ copies stay
         the editable source of truth. -->
    <EmbeddedResource Include="..\..\assets\brand\laghound-glyph.svg"
                      Link="brand\laghound-glyph.svg"
                      LogicalName="Networker.ControlPlane.brand.laghound-glyph.svg" />
    <EmbeddedResource Include="..\..\assets\brand\laghound-wordmark.svg"
                      Link="brand\laghound-wordmark.svg"
                      LogicalName="Networker.ControlPlane.brand.laghound-wordmark.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.0.1" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <!-- EFCore pinned explicitly: Npgsql 10.0.3 pulls EFCore 10.0.4
         transitively; we want the latest patch (query-compilation
         concurrency fixes — the 2026-08-11 system/health incident). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Pure-managed .docx writer for the report exporters (no native deps). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- Override DocumentFormat.OpenXml's transitive System.IO.Packaging 8.0.0,
         which carries GHSA-f32c-w444-8ppv / GHSA-qj66-m88j-hmgj (the C# audit
         gate in dotnet.yml fails on transitive advisories). 9.0.x is patched. -->
    <PackageReference Include="System.IO.Packaging" Version="9.0.9" />
    <!-- PDF export (Reports/Documents/PdfReportExporter). QuestPDF is code-first
         and MIT (Community licence set at startup); it renders via SkiaSharp.
         On Linux the .NoDependencies native asset bundles a fontconfig-free
         libSkiaSharp so the prod VM needs no apt packages — the doc pins its own
         font (QuestPDF's embedded Lato) and never enumerates system fonts. -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Networker.Data\Networker.Data.csproj" />
    <ProjectReference Include="..\Networker.Contracts\Networker.Contracts.csproj" />
    <ProjectReference Include="..\Networker.Security\Networker.Security.csproj" />
  </ItemGroup>

</Project>
