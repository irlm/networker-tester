#!/usr/bin/env bash
# ci-vm-start — start stopped CI VMs on this Proxmox host.
#
# The counterpart to ci-vm-idle-stop, which was missing until v0.28.313 and is
# why CI silently decayed to a single host. idle-stop is a ONE-WAY door: it
# shuts VMs down after IDLE_MINUTES and nothing ever started them again, so
# Linux CI capacity fell to zero and stayed there. On 2026-09-05 all five
# ci-linux VMs were stopped by 01:15 UTC and every job for the next day
# queued behind the one always-on containerised host (ci-turing-1).
#
# Starting a VM is enough to restore capacity: each CI host runs the ephemeral
# loop as a boot service, so it registers with GitHub on its own once up.
#
#   ci-vm-start              start every stopped CI VM that fits in RAM
#   ci-vm-start 3            start at most 3
#   ci-vm-start 301 302      start these VMIDs specifically
#   ci-vm-start --all        ignore the RAM headroom guard
#   ci-vm-start --dry-run    print what would start
#
# Config via /etc/default/ci-vm-idle-stop (shared with the stopper):
#   CI_NAME_PREFIX=ci-   EXCLUDE_VMIDS="400 401"
# Plus, honoured here only:
#   RESERVE_MB=4096        host RAM to leave free (default 4 GiB)
set -euo pipefail

# Defaults that a pre-set environment variable still wins over, so the script
# can be driven without editing /etc/default (and can be tested at all).
CI_NAME_PREFIX="${CI_NAME_PREFIX:-ci-}"
EXCLUDE_VMIDS="${EXCLUDE_VMIDS:-}"
RESERVE_MB="${RESERVE_MB:-4096}"
# Precedence: built-in default < /etc/default < an explicit environment
# variable. Sourcing the file would otherwise silently beat `DRY_RUN=1 ci-vm-start`
# on the command line, which is exactly how an operator expects to force a
# one-off run — so remember what the environment set and re-apply it after.
_env_CI_NAME_PREFIX="${CI_NAME_PREFIX-}"
_env_EXCLUDE_VMIDS="${EXCLUDE_VMIDS-}"
_env_RESERVE_MB="${RESERVE_MB-}"
# shellcheck source=/dev/null  # node-local config; never present in the repo
[ -r /etc/default/ci-vm-idle-stop ] && . /etc/default/ci-vm-idle-stop
[ -n "${_env_CI_NAME_PREFIX}" ] && CI_NAME_PREFIX="${_env_CI_NAME_PREFIX}"
[ -n "${_env_EXCLUDE_VMIDS}" ] && EXCLUDE_VMIDS="${_env_EXCLUDE_VMIDS}"
[ -n "${_env_RESERVE_MB}" ] && RESERVE_MB="${_env_RESERVE_MB}"

DRY_RUN=0
IGNORE_RAM=0
LIMIT=""
VMIDS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) DRY_RUN=1 ;;
    --all)        IGNORE_RAM=1 ;;
    -h|--help)    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit 0 ;;
    ''|*[!0-9]*)  echo "unknown argument: $1" >&2; exit 2 ;;
    *)            if [ "${#1}" -ge 3 ]; then VMIDS+=("$1"); else LIMIT="$1"; fi ;;
  esac
  shift
done

log() { echo "[ci-vm-start] $*"; }

excluded() { case " $EXCLUDE_VMIDS " in *" $1 "*) return 0;; esac; return 1; }

# Free host RAM in MiB. `available` is the honest number: it counts reclaimable
# page cache, which `free` alone does not.
free_mb() { awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo; }

# Stopped CI VMs, by name prefix. Column 3 of `qm list` is STATUS, 4 is MEM.
stopped_ci_vms() {
  qm list | awk -v p="$CI_NAME_PREFIX" 'NR>1 && $3=="stopped" && index($2,p)==1 {print $1, $4}'
}

started=0
avail="$(free_mb)"
log "host has ${avail} MiB available, reserving ${RESERVE_MB} MiB"

while read -r id mem; do
  [ -n "${id:-}" ] || continue
  # An explicit VMID list overrides every other filter except exclusion.
  if [ "${#VMIDS[@]}" -gt 0 ]; then
    case " ${VMIDS[*]} " in *" $id "*) ;; *) continue;; esac
  fi
  excluded "$id" && { log "VM $id excluded"; continue; }
  [ -n "$LIMIT" ] && [ "$started" -ge "$LIMIT" ] && break

  if [ "$IGNORE_RAM" = "0" ] && [ "${#VMIDS[@]}" -eq 0 ]; then
    if [ $(( avail - mem )) -lt "$RESERVE_MB" ]; then
      log "VM $id needs ${mem} MiB — would leave under ${RESERVE_MB} MiB free, stopping here"
      break
    fi
  fi

  if [ "$DRY_RUN" = "1" ]; then
    log "VM $id (${mem} MiB) — WOULD start (dry-run)"
    # Decrement in dry-run too, or the preview reports every VM as startable
    # regardless of how little RAM is left — the exact question --dry-run is
    # asked to answer.
    avail=$(( avail - mem ))
  else
    log "VM $id (${mem} MiB) — starting"
    if qm start "$id"; then
      avail=$(( avail - mem ))
    else
      log "VM $id failed to start"
      continue
    fi
  fi
  started=$(( started + 1 ))
done <<EOF
$(stopped_ci_vms)
EOF

if [ "$started" -eq 0 ]; then
  log "nothing to start (no stopped CI VMs matched, or no RAM headroom)"
else
  log "started ${started} CI VM(s); each registers with GitHub once its boot service is up"
fi
