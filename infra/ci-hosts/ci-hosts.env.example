# infra/ci-hosts/ci-hosts.env — answers for setup-ci-hosts.sh.
# Copy to ci-hosts.env (git-ignored) and edit. Every value is a DEFAULT for the
# interactive prompts; with --non-interactive the file must answer everything
# the run needs. The PAT is never stored here: export CI_HOSTS_PAT in the
# environment (or let the script read it from `gh auth token`).

# ── GitHub ────────────────────────────────────────────────────────────────────
GH_REPO=irlm/networker-tester            # default: derived from `git remote get-url origin`
RUNNER_GROUP=                            # optional GitHub runner group (restrict it to this repo)

# ── Proxmox (Linux CI hosts) ─────────────────────────────────────────────────
PVE_HOST=pve                             # ssh alias (from ~/.ssh/config) or user@host for the Proxmox node
PVE_STORAGE=local-lvm                    # VM disk storage
PVE_SNIPPET_STORAGE=local                # storage for cloud-init user-data; "snippets" content is enabled
                                         # automatically (pve's `dir: local` ships without it — every existing type is kept)
PVE_BRIDGE=vmbr0
PVE_VLAN=                                # VLAN tag for the CI VLAN (empty = untagged, as on vmbr0 today)
PVE_TEMPLATE_ID=9001                     # Ubuntu 24.04 (noble) cloud-init template, created if missing
                                         # (9000 is the old 22.04 template — never reused)
LINUX_COUNT=3                            # number of Linux CI hosts
LINUX_VMID_BASE=301                      # ci-linux-1 = 301, ci-linux-2 = 302, ... (300-310 are free)
LINUX_CORES=4
LINUX_MEMORY_MB=8192
LINUX_DISK=60G
LINUX_IP=dhcp                            # dhcp, or a CIDR base like 10.30.0.10/24 (host N gets .10+N-1)
LINUX_GW=                                # required when LINUX_IP is a CIDR
SSH_PUBKEY_FILE=                         # injected into the VMs (user "ops"); default: the first of
                                         # ~/.ssh/id_ed25519.pub, ~/.ssh/id_ed25519_cihosts.pub, ~/.ssh/id_rsa.pub that exists
WAIT_ONLINE_MINUTES=25                   # first boot installs the toolchain

# ── Windows CI host (optional) ───────────────────────────────────────────────
WINDOWS_ENABLE=no                        # yes = create (or reuse) the VM; the in-guest install runs over ssh or manually
WINDOWS_EXISTING_VMID=                   # e.g. 101 (the stopped "WindowsDesktop" VM) to reuse it instead of creating one
WINDOWS_VMID=310                         # new VM: 6 vCPU / 16 GB / 120 GB, q35 + OVMF + vTPM like VM 101
WINDOWS_ISO=local:iso/26100.32230.260111-0550.lt_release_svc_refresh_SERVER_EVAL_x64FRE_en-us.iso
WINDOWS_VIRTIO_ISO=local:iso/virtio-win.iso
WINDOWS_ANSWER_ISO=local:iso/win-answer.iso   # autounattend ISO attached as a 2nd CD (empty = interactive install)
WINDOWS_CORES=6
WINDOWS_MEMORY_MB=16384
WINDOWS_DISK=120G
WINDOWS_SSH=                             # Administrator@<ip> once OpenSSH Server is enabled in the guest

# ── Mac mini (macOS CI host) ─────────────────────────────────────────────────
MAC_ENABLE=yes
MAC_SSH=macmini                          # ssh alias or user@host; Remote Login must be enabled on the Mac
                                         # (first run needs the Mac password for Homebrew/casks/pmset — run interactively once)
MAC_NAME=ci-macos-1

# ── destroy (non-interactive only) ───────────────────────────────────────────
DESTROY_CONFIRM=no                       # yes = `destroy --non-interactive` may proceed

# Labels a VM/bare-metal CI host registers with. `bare-metal` is what routes the
# jobs that need a REAL machine — a systemd unit, or `tc netem` on the loopback.
# A containerised host (infra/ci-hosts/container) must NOT carry it: it has no
# init system and no NET_ADMIN, so those jobs fail on the host, not the change.
# Changing this is cheap: edit LABELS= in /etc/ci-host/env and restart ci-host;
# the ephemeral loop re-registers with the new set on its next cycle.
CI_HOST_LABELS=self-hosted,linux,networker-ci,bare-metal
