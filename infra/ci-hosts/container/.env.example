# Copy to infra/ci-hosts/container/.env and fill in. Not committed.
CI_HOST_REPO=irlm/networker-tester
CI_HOST_NAME=ci-turing-1
CI_HOST_LABELS=self-hosted,linux,networker-ci
# A root-owned 0600 file holding a PAT with repository Administration:write.
# Keep it OUTSIDE the repo.
CI_HOST_TOKEN_FILE=/etc/ci-host/token
# Leave headroom for whatever else the machine is already doing.
CI_HOST_MEM_LIMIT=24g
CI_HOST_CPUS=10
