# Optional public reference apps shown on the SDK Endpoints page.
# VITE_* values are embedded in the browser bundle. The demo token is public by
# design; never put a production LagHound token here.
VITE_LAGHOUND_CSHARP_DEMO_URL=
VITE_LAGHOUND_RUST_DEMO_URL=
VITE_LAGHOUND_PUBLIC_DEMO_TOKEN=demo-token-laghound
# Optional: where infra-scorecard (github.com/irlm/infra-scorecard) is deployed:
# an http(s) URL or a path on this site (release builds use /scorecard/ when
# the INFRA_SCORECARD_TOKEN secret is set).
# When set, each environment of an application-benchmark comparison gets an
# "Open in infra-scorecard" link that carries the results in the URL fragment.
VITE_INFRA_SCORECARD_URL=
