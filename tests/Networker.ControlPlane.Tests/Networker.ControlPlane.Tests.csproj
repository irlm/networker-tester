<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- NU1903: SQLitePCLRaw.lib.e_sqlite3 advisory, pulled transitively by
         Microsoft.EntityFrameworkCore.Sqlite. Test-only, in-memory database,
         no untrusted input — not shipped in any product artifact. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Networker.ControlPlane\Networker.ControlPlane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical cross-stack modes manifest (repo root shared/modes.json),
         linked (not copied) so ModesManifestTests always guards the real
         file. See the manifest's $comment for the guard topology. -->
    <Content Include="..\..\shared\modes.json" Link="shared\modes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cross-stack HTTP-stack port table (see ProxyHttpsPortTests). -->
    <Content Include="..\..\shared\http-stacks.json" Link="shared\http-stacks.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tester probe schema (see TesterSchemaBootstrapTests). -->
    <Content Include="..\..\shared\tester-schema.postgres.sql" Link="shared\tester-schema.postgres.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
