#!/usr/bin/env bash
# Stub for gh (GitHub CLI).
#
# STUB_GH_RELEASE_TAG    Tag returned by "gh release list"   (default: v0.12.65)
# STUB_GH_FAIL           If set to "1", always exit 1

if [[ "${STUB_GH_FAIL:-}" == "1" ]]; then
    exit 1
fi

_gh_create_archive() {
    local dir="$1" pattern="$2"
    local stub_bin="${pattern%.tar.gz}"
    local stub_bin_name
    stub_bin_name="$(basename "$stub_bin")"
    # Real release tarballs contain the BARE binary name — release.yml does
    # `tar czf networker-tester-${TARGET}.tar.gz -C "$SRC" networker-tester`.
    # This stub used to pack `networker-tester-x86_64-unknown-linux-musl`
    # instead, so step_download_release's `chmod +x "$tmp/networker-tester"`
    # always failed and the function always returned 1. Every assertion about
    # a SUCCESSFUL download was therefore unreachable — which nobody noticed,
    # because those assertions were non-final and inert under `set +e`
    # (P1-13, 2026-08-05). Strip the target triple so the archive matches
    # what the release actually ships.
    stub_bin_name="${stub_bin_name%%-x86_64*}"
    stub_bin_name="${stub_bin_name%%-aarch64*}"

    mkdir -p "$dir"
    # A PRIVATE staging dir per invocation. This used to stage at the shared
    # path /tmp/<binary>, which races when two installs run concurrently — and
    # one bats test starts exactly two on purpose ("concurrent installs to same
    # INSTALL_DIR"). Interleaved, one process's `rm -f` deleted the file before
    # the other had tarred it, producing an empty archive; the install then
    # failed with no explanation and the test flaked on a REQUIRED check.
    local stage
    stage="$(mktemp -d)"
    printf '#!/usr/bin/env bash\necho "%s 0.12.65"\n' "$stub_bin_name" \
        > "${stage}/${stub_bin_name}"
    chmod +x "${stage}/${stub_bin_name}"
    tar czf "${dir}/${pattern}" -C "$stage" "${stub_bin_name}" 2>/dev/null
    rm -rf "$stage"
}

case "$*" in
    *"release list"*)
        echo "[{\"tagName\":\"${STUB_GH_RELEASE_TAG:-v0.12.65}\"}]"
        ;;
    *"release download"*)
        # Parse --dir and --pattern from argument list
        dl_dir=""
        dl_pattern=""
        prev=""
        for arg in "$@"; do
            case "$prev" in
                --dir)     dl_dir="$arg" ;;
                --pattern) dl_pattern="$arg" ;;
            esac
            prev="$arg"
        done
        if [[ -n "$dl_dir" && -n "$dl_pattern" ]]; then
            _gh_create_archive "$dl_dir" "$dl_pattern"
        fi
        ;;
    *)
        ;;
esac
exit 0
