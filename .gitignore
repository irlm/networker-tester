# Rust build artifacts
/target/

# Cargo lockfile is kept for applications (this is a binary workspace)
# Cargo.lock

# Output directory - generated reports and JSON artifacts
/output/
/networker-cloud.json

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment / secrets
.env
*.env

# Claude Code
.claude/
CLAUDE.md
.superpowers/
.worktrees/
benchmarks/orchestrator/target/
benchmarks/metrics-agent/target/
benchmarks/reference-apis/*/publish/
benchmarks/reference-apis/**/bin/
benchmarks/reference-apis/**/obj/
# Block .sln in root only (benchmarks/reference-apis/benchmarks.sln is tracked)
/*.sln
# ...except the C# solution, which lives at repo root by design
!/Networker.sln

# C# / .NET build output (src/ = projects, tests/ = test projects, sdk/ = language SDKs)
src/**/bin/
src/**/obj/
tests/**/bin/
tests/**/obj/
sdk/**/bin/
sdk/**/obj/
*.user
.vs/
.idea/

# Python bytecode (SDK) — never commit compiled caches
__pycache__/
*.py[cod]

# BenchmarkDotNet local run output (tests/Networker.Benchmarks)
BenchmarkDotNet.Artifacts/
test-results/

# Local dev / lab state (dev.sh, lab/lab.sh)
/.dev-agent.key
/lab/.generated/
/lab/.generated-*/
/lab/.state/
/lab/.state-*/
/lab/native/.state/
/.dev.env

# Prod UI smoke harness (scripts/prod-smoke.sh) — local token + run artifacts
/.prod-smoke.env
/dashboard/e2e/prod/artifacts/

# self-hosted CI host answers (infra/ci-hosts/setup-ci-hosts.sh) — never the PAT, but keep host names/IPs local
infra/ci-hosts/ci-hosts.env
